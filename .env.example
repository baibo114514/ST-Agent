# ==========================================
# 核心环境配置 (Environment Configuration)
# ==========================================
APP_ENV=development
PROJECT_NAME="FastAPI LangGraph Agent"
VERSION=1.0.0
DEBUG=true

# ==========================================
# API & 安全设置 (API & Security)
# ==========================================
API_V1_STR=/api/v1
# 允许跨域的域名列表，生产环境请修改为实际域名
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000"
PLATFORM_ADMIN_EMAILS="admin@example.com"

# ==========================================
# Knowledge Service (Independent Microservice)
# ==========================================
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8010
KNOWLEDGE_SERVICE_TOKEN="change-me-local-knowledge-token"
KNOWLEDGE_SERVICE_CONNECT_TIMEOUT_SECONDS=5
KNOWLEDGE_SERVICE_REQUEST_TIMEOUT_SECONDS=120
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://postgres:your_secure_db_password@127.0.0.1:5432/agent_db
# ---- embedding：默认 provider=api 走外部 API（SiliconFlow），无需本地 Ollama ----
# 注意：切换 provider 后需清空 td_knowledge_chunk 重新入库（向量不可混用）
KNOWLEDGE_EMBEDDING_PROVIDER=api
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KNOWLEDGE_EMBEDDING_API_KEY="sk-your-siliconflow-api-key"
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
# 本地 Ollama（provider=local）按需启用：
# KNOWLEDGE_EMBEDDING_PROVIDER=local
# KNOWLEDGE_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# KNOWLEDGE_EMBEDDING_API_KEY=ollama
# KNOWLEDGE_EMBEDDING_MODEL=bge-m3
KNOWLEDGE_RERANKER_BASE_URL=
KNOWLEDGE_RERANKER_API_KEY=
KNOWLEDGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KNOWLEDGE_MAX_FILE_SIZE_MB=50
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_DATABASE_POOL_SIZE=20
KNOWLEDGE_DATABASE_MAX_OVERFLOW=10
KNOWLEDGE_DATABASE_POOL_TIMEOUT_SECONDS=60
KNOWLEDGE_INGEST_CONCURRENCY=2
KNOWLEDGE_INGEST_RATE_LIMIT="10000 per hour"
KNOWLEDGE_ALLOWED_NAMESPACES=default,policy,customer_service

# ==========================================
# JWT 认证设置 (Authentication)
# ==========================================
# 【重要】生产环境请用 `openssl rand -hex 32` 生成随机长字符串替换此处
JWT_SECRET_KEY="your-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ==========================================
# 数据库设置 (PostgreSQL + pgvector)
# ==========================================
# 当前推荐混合开发：数据库在 Docker，主后端和 knowledge-service 在宿主机本地运行
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ==========================================
# 大模型服务 (LLM - DeepSeek/OpenAI Compatible)
# ==========================================
# 默认使用 DeepSeek 官方 API，注册地址: https://platform.deepseek.com/
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY="sk-your-llm-api-key"
DEFAULT_LLM_MODEL=deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4000
MAX_LLM_CALL_RETRIES=3

# ==========================================
# Langfuse 可观测性监控 (Observability)
# ==========================================
# 注册地址: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY="pk-lf-local"
LANGFUSE_SECRET_KEY="sk-lf-local"
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# 工具箱配置 (Agent Tools)
# ==========================================
# 1. AnySearch 联网搜索 (https://anysearch.com/)
ANYSEARCH_API_KEY=""
ANYSEARCH_API_URL="https://api.anysearch.com/v1/search"
ANYSEARCH_ZONE="cn"
ANYSEARCH_LANGUAGE="zh-CN"

# 2. 短期记忆摘要阈值 (超过多少条消息开始压缩)
SUMMARY_THRESHOLD=10

# 3. 邮件发送服务 (SMTP) - 支持 QQ/网易等邮箱
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER="your-email@qq.com"
# 注意：这里填写的是授权码，不是登录密码
EMAIL_SMTP_PASSWORD="your-smtp-auth-code"
EMAIL_SMTP_USE_SSL=true
EMAIL_FROM_NAME="AI 智能助手"

# ==========================================
# 速率限制配置 (Rate Limiting)
# ==========================================
RATE_LIMIT_DEFAULT="1000 per day, 200 per hour"


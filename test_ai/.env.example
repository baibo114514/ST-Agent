# Copy this file to test_ai/.env.local and fill in local test credentials.
# Never commit test_ai/.env.local or real passwords/tokens.

AI_TEST_BASE_URL=http://127.0.0.1:8000
AI_TEST_EMAIL=admin@example.com
AI_TEST_PASSWORD=replace-with-local-password

# All three members must use this same published Agent configuration.
AI_TEST_AGENT_CODE=policy-assistant
AI_TEST_MODEL_NAME=deepseek-chat
AI_TEST_TOP_K=5
AI_TEST_SCORE_THRESHOLD=0.2

# Keep requests below the default Agent chat rate limit (20/minute).
AI_TEST_REQUEST_INTERVAL_SECONDS=3.2
AI_TEST_TIMEOUT_SECONDS=180
AI_TEST_KEEP_SESSIONS=false